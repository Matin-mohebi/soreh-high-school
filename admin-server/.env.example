# سرویس مدیریت دبیرستان سوره — نمونه‌ی تنظیمات
# این فایل را به .env کپی کنید و مقادیر را پر کنید:
#   cp .env.example .env

# ---------- حساب مدیر پنل ----------
# نام کاربری مدیر
ADMIN_USERNAME=admin

# رمز مدیر (هش scrypt — هرگز رمز خام را ننویسید)
# ساخت هش:  node server.js hashpass «رمز-مورد-نظر»
# خروجی دستور را اینجا قرار دهید (شکل: salt:hash)
ADMIN_PASSWORD_HASH=

# کلید امضای نشست‌ها — حداقل ۳۲ نویسه تصادفی
# ساخت:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ---------- انتشار به GitHub (اختیاری ولی برای انتشار لازم) ----------
# توکن Personal Access Token با دسترسی «Contents: Read and write» فقط روی همین مخزن
# ساخت: GitHub → Settings → Developer settings → Fine-grained tokens
GITHUB_TOKEN=

# مخزن و شاخه‌ی انتشار
GITHUB_REPO=Matin-mohebi/soreh-high-school
GITHUB_BRANCH=main

# ---------- سرور ----------
PORT=8787
