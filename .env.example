# دبیرستان سوره — نمونه فایل محیط (کپی به .env و پر کردن مقادیر)
DATABASE_URL=file:/absolute/path/to/db/custom.db

# انتشار در گیت‌هاب (توکن فقط سمت سرور — هرگز کامیت نشود)
GITHUB_TOKEN=
GITHUB_REPO=Matin-mohebi/soreh-high-school
GITHUB_BRANCH=migration/soreh-school
GITHUB_CONTENT_PATH=site/assets/content.json
GITHUB_PUSH_MEDIA=1

# اجازه CORS برای نسخه استاتیک گیت‌هاب پیجز
CORS_ORIGINS=https://matin-mohebi.github.io
CORS_OPEN=0
